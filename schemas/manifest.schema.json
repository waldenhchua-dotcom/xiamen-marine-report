{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/xiamen-marine-report/manifest.schema.json",
  "title": "Frozen marine evidence manifest v1",
  "type": "object",
  "required": ["schema_version", "run_id", "request_date", "timezone", "state", "synthetic", "analysis_provider", "created_at", "sites", "sources", "extrema", "series", "official_documents", "gaps"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "request_date": {"type": "string", "format": "date"},
    "timezone": {"const": "Asia/Shanghai"},
    "state": {"const": "FETCHED"},
    "synthetic": {"type": "boolean"},
    "analysis_provider": {"const": "none"},
    "created_at": {"type": "string", "format": "date-time"},
    "sites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/site"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "extrema": {"type": "array", "items": {"$ref": "#/$defs/extremum"}},
    "series": {"type": "array", "items": {"$ref": "#/$defs/series"}},
    "official_documents": {"type": "array", "items": {"$ref": "#/$defs/official"}},
    "gaps": {"type": "array", "items": {"type": "object", "required": ["code", "message", "blocking"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "site_id": {"type": ["string", "null"]}, "blocking": {"type": "boolean"}}}}
  },
  "$defs": {
    "site": {"type": "object", "required": ["id", "name", "target_point", "reference_station"], "properties": {"id": {"enum": ["haicang", "wuyuan", "huandong"]}, "name": {"type": "string"}, "target_point": {"type": "object", "required": ["latitude", "longitude", "crs", "precision", "provenance", "limitations"], "properties": {"latitude": {"type": "number", "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "minimum": -180, "maximum": 180}, "crs": {"const": "WGS84"}}}, "reference_station": {"type": "object", "required": ["id", "name", "latitude", "longitude", "datum", "timezone_verified"], "properties": {"timezone_verified": {"type": "boolean"}, "latitude": {"type": ["number", "null"]}, "longitude": {"type": ["number", "null"]}}}}},
    "source": {"type": "object", "required": ["id", "file", "sha256", "retrieved_at", "request", "http_status", "kind", "license", "metadata"], "properties": {"id": {"type": "string"}, "file": {"type": "string", "pattern": "^evidence/[^:]+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "retrieved_at": {"type": "string", "format": "date-time"}, "request": {"type": "object", "required": ["url", "params"]}, "http_status": {"type": "integer"}, "kind": {"enum": ["forecast", "synthetic", "astronomical", "official", "observed", "historical"]}, "license": {"type": "string"}, "metadata": {"type": "object"}}},
    "extremum": {"type": "object", "required": ["station_id", "time", "height", "type", "unit", "datum", "source_id"], "properties": {"time": {"type": "string", "format": "date-time"}, "height": {"type": "number"}, "type": {"enum": ["low", "high"]}, "unit": {"const": "m"}}},
    "series": {"type": "object", "required": ["site_id", "variable", "timestamps", "values", "unit", "source_id", "kind", "grid"], "properties": {"variable": {"enum": ["tide_height", "wind_speed", "wind_gust", "wind_direction", "precipitation", "precipitation_probability", "weather_code", "temperature", "wave_height", "swell_height", "swell_period", "current_speed", "current_direction", "sea_temperature"]}, "timestamps": {"type": "array", "items": {"type": "string", "format": "date-time"}}, "values": {"type": "array", "items": {"type": ["number", "null"]}}, "direction_convention": {"enum": ["from", "toward"]}, "grid": {"type": "object", "required": ["latitude", "longitude", "distance_km", "resolution", "verified"], "properties": {"verified": {"type": "boolean"}, "distance_km": {"type": "number", "minimum": 0}}}}},
    "official": {"type": "object", "required": ["site_id", "category", "status", "source_id", "request_date", "title", "published_at", "valid_from", "valid_to", "summary"], "properties": {"category": {"enum": ["warning", "marine_forecast"]}, "status": {"enum": ["verified", "not_obtained", "not_yet_published"]}, "source_id": {"type": ["string", "null"]}}}
  }
}
